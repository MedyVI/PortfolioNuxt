# Variables d'environnement - Portfolio MédyVI
# Copiez ce fichier vers .env et remplissez vos vraies valeurs

# URL de base du site (utilisée pour les meta tags SEO)
NUXT_PUBLIC_SITE_URL=https://votre-domaine.com

# Informations de contact
NUXT_PUBLIC_CONTACT_EMAIL=votre.email@example.com

# Réseaux sociaux
NUXT_PUBLIC_GITHUB_URL=https://github.com/votre-username
NUXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/votre-profile
NUXT_PUBLIC_TWITTER_URL=https://twitter.com/votre-username

# Analytics (optionnel - décommentez si vous utilisez)
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NUXT_PUBLIC_PLAUSIBLE_DOMAIN=votre-domaine.com

# API externes (si nécessaire plus tard)
# NUXT_API_SECRET=votre-secret-api
# NUXT_GITHUB_TOKEN=votre-token-github (pour afficher les repos)
